# Supabase Configuration
# Find these in your Supabase project settings: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The Groq API key is NOT stored here.
# Users add their own Groq API key directly in the app's Settings page,
# and it is stored securely in the user_settings database table.
